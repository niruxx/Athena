# Maintainer: niruxxdaboi <perezkyle98@protonmail.com>
#
# This PKGBUILD builds from the checked-out repository itself rather than a
# downloaded source tarball, so it must stay exactly two directories below
# the repository root (packaging/arch/PKGBUILD) — build()/package() locate
# the source tree via $startdir/../..

pkgname=athena
pkgver=3.0.0
pkgrel=2
pkgdesc="Cross-distro GUI package manager for DNF, APT, Pacman, and Flatpak"
arch=('x86_64')
url="https://github.com/niruxx/Athena"
license=('GPL-3.0-or-later')
# pkexec is in polkit; its password prompt needs an authentication agent
# running in the session. Athena starts this one itself when the desktop
# doesn't run any (bare compositors such as niri, Hyprland, or sway).
depends=('qt6-base' 'polkit' 'polkit-kde-agent')
makedepends=('cmake')
optdepends=('git: AUR support'
            'base-devel: building AUR packages'
            'paru: preferred AUR helper (yay also works; makepkg is used otherwise)'
            'archlinux-appstream-data: find apps that are not installed yet in Discover'
            'kimageformats: app icons from the Arch app catalog (JPEG XL)'
            'snapper: system snapshots before changes, and restoring them (Btrfs)'
            'timeshift: system snapshots before changes, and restoring them')
source=()
sha256sums=()

_reporoot="$startdir/../.."

build() {
    cmake -S "$_reporoot" -B "$srcdir/build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build "$srcdir/build" -j"$(nproc)"
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
