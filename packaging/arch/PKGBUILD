# Maintainer: niruxxdaboi <perezkyle98@protonmail.com>
#
# Builds from the checked-out repository itself rather than a downloaded
# source tarball, so it must stay two directories below the repository
# root (packaging/arch/PKGBUILD): build() and package() find the source
# tree through $startdir/../..

pkgname=athena
# Cargo.toml's version without hyphens (pacman doesn't allow them):
# sh packaging/version.sh arch
pkgver=4.0.0alpha.1
pkgrel=1
pkgdesc="Install, update, and remove software from pacman, Flatpak, and Snap in one GTK app"
arch=('x86_64' 'aarch64')
url="https://github.com/niruxx/Athena"
license=('GPL-3.0-or-later')
# pkexec is in polkit; its password prompt needs an authentication agent
# running in the session. Athena starts polkit-gnome itself when the
# desktop doesn't run an agent (bare compositors such as niri or sway).
depends=('gtk4' 'libadwaita' 'polkit' 'polkit-gnome')
makedepends=('cargo')
optdepends=('flatpak: Flatpak apps'
            'snapd: snaps (from the AUR)')
options=('!lto')
source=()
sha256sums=()

_reporoot="$startdir/../.."

build() {
    cd "$_reporoot"
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo build --release --locked -p athena
}

check() {
    cd "$_reporoot"
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo test --release --locked -p athena-core
}

package() {
    cd "$_reporoot"
    DESTDIR="$pkgdir" sh packaging/install.sh "$srcdir/target/release/athena"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
